{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TM Code",
  "version": "0.7.6",
  "identifier": "com.ithustle.toquemedia-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [],
    "security": {}
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/templates/**/*",
      "resources/skills/**/*"
    ],
    "fileAssociations": [
      {
        "ext": ["txt", "md", "markdown", "mdx", "log", "rst"],
        "name": "Text Document",
        "description": "Open in TM Code",
        "role": "Editor"
      },
      {
        "ext": [
          "js", "jsx", "mjs", "cjs", "ts", "tsx",
          "html", "htm", "css", "scss", "sass", "less",
          "json", "yaml", "yml", "toml", "xml", "svg",
          "py", "rb", "go", "rs", "java", "kt", "swift",
          "c", "h", "cpp", "hpp", "cc", "cs", "m", "mm",
          "php", "sh", "bash", "zsh", "fish", "ps1",
          "sql", "vue", "svelte", "astro", "lua", "dart",
          "env", "ini", "conf", "config"
        ],
        "name": "Source Code",
        "description": "Open in TM Code",
        "role": "Editor"
      }
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "Developer ID Application: TOQUE MEDIA - PRESTACAO DE SERVICOS, LDA (D39GPSWXDH)"
    },
    "windows": {
      "certificateThumbprint": "362CFA7356BFAC4CF0E66EAEC9E8F7622FA623D0",
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.comodoca.com"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxMjBCRkM4RDRCMUVFNEEKUldSSzdySFV5TDhnMGY4dzl5eW9yQW16REFPR3VBZG5FMStOc0R4d0haM2c1cStOdm82K0dGWlcK",
      "endpoints": [
        "https://github.com/ToqueMedia/TM-Code/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
