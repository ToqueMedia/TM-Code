<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Team voice calls: without this, the hardened-runtime (signed) build is
	     denied microphone access at the OS level — getUserMedia would fail in
	     release even though it works in `tauri dev`. Pairs with the
	     NSMicrophoneUsageDescription entry in Info.plist. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
