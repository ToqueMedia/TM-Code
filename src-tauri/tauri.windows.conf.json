{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": null,
      "timestampUrl": null,
      "signCommand": {
        "cmd": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "$script = Join-Path $env:GITHUB_WORKSPACE 'scripts/sign-windows.ps1'; & $script '%1'"
        ]
      }
    }
  }
}
