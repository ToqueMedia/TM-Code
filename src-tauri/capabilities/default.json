{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    "fs:default",
    "fs:allow-watch",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    {
      "identifier": "fs:scope",
      "allow": [
        "$HOME/**/*",
        "$APPDATA/**/*",
        "$DOCUMENTS/**/*",
        "$DOWNLOAD/**/*",
        "$DESKTOP/**/*",
        "$MUSIC/**/*",
        "$PICTURES/**/*",
        "$VIDEOS/**/*",
        "$PUBLIC/**/*",
        "$TEMP/**/*"
      ]
    }
  ]
}
