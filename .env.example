# Firebase Configuration (required for auth)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Backend Worker URL (control plane/admin/auth/deploy/BYOK)
VITE_WORKER_URL=http://192.168.64.1:8787
# AI data-plane Worker URL (POST /v1/chat/completions)
VITE_AI_WORKER_URL=http://192.168.64.1:8788


# App Check Configuration
VITE_APPCHECK_ENABLED=
VITE_APPCHECK_DEBUG_TOKEN=

# GitHub OAuth App client_id — enables "Sign in with GitHub" (device flow) to
# clone PRIVATE repos. Public value, safe to ship (device flow needs no secret).
# Setup: github.com/settings/developers → New OAuth App → enable "Device Flow",
# then paste the Client ID here. Leave blank to allow only public-repo clones.
VITE_GITHUB_CLIENT_ID=
