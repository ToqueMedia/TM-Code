{
  "name": "toquemedia-studio",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "evals:agent": "node scripts/agent-evals.mjs",
    "dev:ai-worker": "yarn --cwd workers/ai-pass-through dev",
    "dev:collab-worker": "yarn --cwd workers/collab-signaling dev",
    "dev:control-plane": "yarn --cwd ../toquemedia-studio-api dev",
    "dev:workers": "concurrently -k -n api,ai,collab -c yellow,blue,magenta \"yarn dev:control-plane\" \"yarn dev:ai-worker\" \"yarn dev:collab-worker\"",
    "tauri:dev:all": "concurrently -k -n app,api,ai,collab -c cyan,yellow,blue,magenta \"yarn tauri dev\" \"yarn dev:control-plane\" \"yarn dev:ai-worker\" \"yarn dev:collab-worker\"",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "tauri:build:win-x64": "node scripts/build.mjs x86_64-pc-windows-msvc --require-updater-artifacts",
    "tauri:build:win-x64:unsigned": "node scripts/build.mjs x86_64-pc-windows-msvc --unsigned",
    "tauri:build:mac-intel": "node scripts/build.mjs x86_64-apple-darwin",
    "tauri:build:mac-arm64": "node scripts/build.mjs aarch64-apple-darwin",
    "release:finalize": "node scripts/finalize-release.mjs",
    "test": "jest",
    "test:ai-worker": "yarn --cwd workers/ai-pass-through test",
    "test:collab-worker": "yarn --cwd workers/collab-signaling test",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "bench:prompt-format": "node scripts/prompt-format-bench.mjs --write",
    "proof:prompt-format": "tsx scripts/prompt-format-proof.mjs"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.34.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-virtual": "^3.13.22",
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "@toon-format/toon": "4.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^8.0.3",
    "firebase": "^12.10.0",
    "framer-motion": "^12.36.0",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.3",
    "lodash-es": "^4.17.21",
    "monaco-editor": "^0.55.1",
    "openai": "^4.80.0",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "use-stick-to-bottom": "^1.1.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/diff": "^8.0.0",
    "@types/jest": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.0.1",
    "@welldone-software/why-did-you-render": "^10.0.1",
    "commander": "^14.0.3",
    "concurrently": "^10.0.3",
    "fake-indexeddb": "^6.2.5",
    "gpt-tokenizer": "2",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
