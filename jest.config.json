{
  "preset": "ts-jest",
  "testEnvironment": "jsdom",
  "setupFilesAfterEnv": ["<rootDir>/src/components/__tests__/setupTests.ts"],
  "moduleNameMapper": {
    "\\.(css|less|scss|sass)$": "identity-obj-proxy",
    "(^|/)viteEnv$": "<rootDir>/src/utils/__mocks__/viteEnv.ts",
    "^@/(.*)$": "<rootDir>/src/$1",
    "^~/(.*)$": "<rootDir>/src/$1"
  },
  "transform": {
    "^.+\\.(ts|tsx)$": ["ts-jest", {
      "tsconfig": "tsconfig.test.json"
    }],
    "^.+\\.mjs$": ["ts-jest", {
      "tsconfig": "tsconfig.test.json",
      "useESM": true
    }]
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(@toon-format/toon)/)"
  ],
  "testMatch": [
    "<rootDir>/src/**/__tests__/**/*.test.{ts,tsx}",
    "<rootDir>/src/**/?(*.)+(spec|test).{ts,tsx}"
  ],
  "testPathIgnorePatterns": [
    "/node_modules/",
    "<rootDir>/src/components/__tests__/setupTests.ts"
  ],
  "moduleFileExtensions": ["ts", "tsx", "js", "jsx", "mjs", "json", "node"],
  "collectCoverageFrom": [
    "src/**/*.{ts,tsx}",
    "!src/**/*.d.ts"
  ]
}
